{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@hemline/shared-types": "workspace:*",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "execa": "^10.0.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
