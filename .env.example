# Postgres connection used by the backend and docker-compose.
DATABASE_URL=postgres://hemline:hemline@localhost:5432/hemline
POSTGRES_USER=hemline
POSTGRES_PASSWORD=hemline
POSTGRES_DB=hemline

# Backend HTTP server.
PORT=3000

# OpenRouter — used server-side only now; the extension no longer holds this key.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Used to name the final downloaded resume, e.g. "John_Doe_Resume.pdf".
CANDIDATE_NAME=John Doe

# Where compiled resume PDFs are written on disk.
STORAGE_DIR=./storage

# Path to the tectonic binary used to compile the tailored .tex to PDF.
TECTONIC_BIN=tectonic

# Cron expression for how often tracked job URLs are re-checked for liveness/expiry.
RECHECK_CRON=0 */6 * * *
